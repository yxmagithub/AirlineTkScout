# Amadeus API credentials (get free at https://developers.amadeus.com)
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret
# Use "production" for live data (requires Amadeus approval), "test" for sandbox
AMADEUS_ENV=test

# Gmail SMTP (use an App Password if 2FA is enabled)
# Guide: https://support.google.com/accounts/answer/185833
GMAIL_ADDRESS=your@gmail.com
GMAIL_APP_PASSWORD=your_app_password
ALERT_EMAIL_TO=recipient@email.com

# Telegram Bot (create a bot via @BotFather, get chat_id via /getUpdates)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
