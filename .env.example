# SerpAPI key — get yours free at https://serpapi.com (100 free searches/mo)
SERPAPI_KEY=your_serpapi_key_here

# Gmail SMTP (use an App Password if 2FA is enabled)
# Guide: https://support.google.com/accounts/answer/185833
GMAIL_ADDRESS=your@gmail.com
GMAIL_APP_PASSWORD=your_app_password
ALERT_EMAIL_TO=recipient@email.com

# Telegram Bot (create a bot via @BotFather, get chat_id via @userinfobot)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
